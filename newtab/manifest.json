{
  "manifest_version": 3,
  "name": "Terminal New Tab",
  "version": "1.0.0",
  "description": "A quiet phosphor terminal with a mouse-reactive grid.",
  "permissions": ["topSites", "search"],
  "chrome_url_overrides": {"newtab": "index.html"},
  "browser_specific_settings": {
    "gecko": {
      "id": "terminal-newtab@pkcpn.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
